# App config
PORT=7000
HOST=http://localhost:7000/api

UPLOAD_PATH=storage/uploads

# Database config
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gazette
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# OAuth client config
IDENTITY_HUB_URL=http://localhost:8000
IDENTITY_HUB_INTERNAL_URL=http://localhost:8000
OAUTH_CLIENT_ID=gazette
OAUTH_ISSUER=identity-hub
OAUTH_REDIRECT_URI=http://localhost:7000/auth/callback
OAUTH_CLIENT_SECRET=replace_me

# Only for the initial local admin bootstrap command
BOOTSTRAP_ADMIN_EXTERNAL_KEY=IDH-U-replace_me

# Environment
NODE_ENV=development

# Auth cookie settings
AUTH_COOKIE_SECURE=false

# Only for local development with a separate frontend origin
CORS_ORIGIN=http://localhost:7001

# Optional. Set it when the frontend runs outside this Nest origin.
GAZETTE_UI_BASE_URL=http://localhost:7001
