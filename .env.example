# Application
NODE_ENV=development
PORT=7000

# Public root URL of this backend. OAuth callback, public file URLs and cookie security are derived from it.
GAZETTE_PUBLIC_URL=http://localhost:7000

# Optional UI URL when Angular runs on a separate origin. It also enables CORS for that origin.
# Omit it when NestJS serves the Angular build from GAZETTE_PUBLIC_URL.
GAZETTE_UI_URL=http://localhost:7001

# File storage
UPLOAD_PATH=storage/uploads

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gazette
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Use true only for local development. Production requires false and migrations.
DATABASE_SYNCHRONIZE=true

# Identity Hub public URL, used for browser redirects, token requests, JWKS and JWT issuer validation.
IDENTITY_HUB_PUBLIC_URL=http://localhost:8000

# Optional server-to-server URL. Omit it when the backend can reach the public URL directly.
# IDENTITY_HUB_INTERNAL_URL=http://localhost:8000

# Confidential OAuth client registered in Identity Hub.
OAUTH_CLIENT_ID=gazette
OAUTH_CLIENT_SECRET=replace_me

# Initial local administrator. Set only while running npm run bootstrap:admin.
# BOOTSTRAP_ADMIN_EXTERNAL_KEY=IDH-U-replace_me
